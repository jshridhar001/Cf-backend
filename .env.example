# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres.fqrvwlwlxlhnbhofjllv:pGEx1zGKhU4DwDPd@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=contract_farming

# Better Auth (BETTER_AUTH_URL must match the API origin clients call)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080

# Frontend origins (keep these in sync for CORS + trustedOrigins).
# In production, both must be the exact frontend origin (e.g. https://app.vercel.app).
# BETTER_AUTH_URL must be https so session cookies can be set cross-site (SameSite=None).
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bhatti Agritech <no-reply@example.com>"

# Optional seed overrides
SEED_DEFAULT_PASSWORD=ChangeMe123!
SEED_SUPER_DEV_EMAIL=super.dev@example.com
SEED_SUPER_DEV_NAME=Super Developer

# Field task schedule offsets (days after plantation startDate).
# Each task keeps the plantation window duration: endDate = startDate + (plantationEnd - plantationStart).
# Example: plantation 2026-09-01 → 2026-09-03 (window=2), ROUGING_OFFSET_DAYS=4 → task 2026-09-05 → 2026-09-07.
ROUGING_OFFSET_DAYS=40
STRIP_TEST_PRE_OFFSET_DAYS=65
DEHAULMING_OFFSET_DAYS=75
STRIP_TEST_POST_OFFSET_DAYS=85
