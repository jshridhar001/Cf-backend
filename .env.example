# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
# NODE_ENV=production uses DATABASE_URL. Every other environment uses DATABASE_URL_DEV.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_farming
DATABASE_URL_DEV=postgresql://postgres:postgres@localhost:5432/contract_farming_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=contract_farming

# Better Auth (BETTER_AUTH_URL must match the API origin clients call)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080

# Frontend origins (keep these in sync for CORS + trustedOrigins)
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bhatti Agritech <no-reply@example.com>"

# Google Drive (seed requisition contract PDFs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/seed-requisitions/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Days after a plantation start date when each follow-up task is due
ROUGING_OFFSET_DAYS=4
STRIP_TEST_PRE_OFFSET_DAYS=8
DEHAULMING_OFFSET_DAYS=12
STRIP_TEST_POST_OFFSET_DAYS=16

# Optional seed overrides
SEED_DEFAULT_PASSWORD=ChangeMe123!
SEED_SUPER_DEV_EMAIL=super.dev@example.com
SEED_SUPER_DEV_NAME=Super Developer

# MSG91 farmer final-confirmation OTP
# Dashboard: https://control.msg91.com
# 1. Authkey → copy the auth key into MSG91_AUTH_KEY.
# 2. OTP → create a DLT-approved template whose only variable is ##OTP##.
#    Paste that OTP template id into MSG91_OTP_TEMPLATE_ID.
#    The SMS text lives in the template. This app does not send message body text.
# 3. Leave the defaults unless the approved template uses a different length or expiry.
#    MSG91_OTP_LENGTH must be 4–9. MSG91_OTP_EXPIRY_MINUTES is 1–10080.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=1277179498712459210
MSG91_COUNTRY_CODE=91
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=10
