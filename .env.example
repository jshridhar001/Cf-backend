# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_farming
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=contract_farming

# Better Auth (BETTER_AUTH_URL must match the API origin clients call)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080

# Frontend origins (keep these in sync for CORS + trustedOrigins)
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bhatti Agritech <no-reply@example.com>"

# Optional seed overrides
SEED_DEFAULT_PASSWORD=ChangeMe123!
SEED_SUPER_DEV_EMAIL=super.dev@example.com
SEED_SUPER_DEV_NAME=Super Developer

# Field task schedule offsets (days after plantation startDate)
ROUGING_OFFSET_DAYS=40
STRIP_TEST_PRE_OFFSET_DAYS=65
DEHAULMING_OFFSET_DAYS=75
STRIP_TEST_POST_OFFSET_DAYS=85
