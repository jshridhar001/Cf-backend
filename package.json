{
  "name": "contract-farming-backend",
  "version": "0.2.1",
  "description": "Backend for contract farming software",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "release": "standard-version",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed-users.ts",
    "db:seed:farmers": "tsx src/db/seed-farmers.ts",
    "db:seed:farmers:2026": "tsx src/db/main_seed_scripts/seed-registered-farmers-2026.ts",
    "db:seed:requisitions": "tsx src/db/seed-script-requisitions.ts",
    "db:seed:dispatches": "tsx src/db/seed-script-dispatches.ts",
    "db:seed:masters": "tsx src/db/seed-master.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "better-auth": "^1.7.11",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "googleapis": "^186.0.0",
    "nodemailer": "^10.1.7",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "standard-version": "^9.5.0",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
