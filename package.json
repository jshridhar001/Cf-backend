{
  "name": "contract-farming-backend",
  "version": "0.2.1",
  "description": "Backend for contract farming software",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "release": "standard-version",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed-users.ts",
    "db:seed:masters": "tsx src/db/seed-master.ts",
    "db:seed:farmers": "tsx src/db/seed-farmers.ts",
    "db:seed:requisitions": "tsx src/db/seed-requisitions.ts",
    "google-drive:connect": "tsx src/features/farmers/google-drive/google-drive.connect.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "better-auth": "^1.7.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "googleapis": "^178.0.0",
    "nodemailer": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "standard-version": "^9.5.0",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
