{
	"name": "contract-farming-backend",
	"version": "0.1.0",
	"description": "Backend for contract farming software",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix",
		"release": "standard-version",
		"prepare": "husky"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.10.0",
		"fastify-plugin": "^6.0.0",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"standard-version": "^9.5.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
