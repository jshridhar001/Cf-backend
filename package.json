{
  "name": "contract-farming-backend",
  "version": "0.2.1",
  "description": "Backend for contract farming software",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "release": "standard-version",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed-users.ts && tsx src/db/seed-masters.ts",
    "db:seed:users": "tsx src/db/seed-users.ts",
    "db:seed:masters": "tsx src/db/seed-masters.ts",
    "db:seed:operations": "tsx src/db/seed-operations.ts",
    "db:clear:fields": "tsx src/db/clear-fields.ts",
    "db:clear:dispatches": "tsx src/db/clear-dispatches.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "standard-version": "^9.5.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
